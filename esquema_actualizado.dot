digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-10-08 05:11
  // Cli Options: patients users -o esquema_actualizado.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
